cabal-version:      3.14
name:               qhask
version:            0.1.0.0
synopsis:           Q-series and partition combinatorics library
license:            MIT
license-file:       LICENSE
author:             Robin Langer
maintainer:         langer.robin@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        QHask.QSeries
        QHask.Partition
        QHask.Profile
        QHask.CPP
        QHask.Conjecture
        QHask.Sym.Types
        QHask.Sym.Kostka
        QHask.Sym.LR
        QHask.Sym.Schur
        QHask.Sym.Monomial
        QHask.Sym.Homogeneous
        QHask.Sym.Elementary
        QHask.Sym.PowerSum
        QHask.Sym
    build-depends:
        base ^>=4.18.3.0,
        containers
    hs-source-dirs:   src
    default-language: GHC2021

test-suite qhask-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        QHask.QSeriesSpec
        QHask.PartitionSpec
        QHask.ProfileSpec
        QHask.CPPSpec
        QHask.ConjectureSpec
        QHask.Sym.TypesSpec
        QHask.Sym.KostkaSpec
        QHask.Sym.LRSpec
        QHask.Sym.SchurSpec
        QHask.Sym.MonomialSpec
        QHask.Sym.HomogeneousSpec
        QHask.Sym.ElementarySpec
        QHask.Sym.PowerSumSpec
        QHask.Sym.SymSpec
    build-depends:
        base ^>=4.18.3.0,
        containers,
        hspec,
        qhask
    hs-source-dirs:   test
    default-language: GHC2021
